{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aham.ai/schemas/aham-survey/transcript-map-v1.json",
  "title": "Aham Survey transcript mapping preview",
  "type": "object",
  "required": ["project", "answers"],
  "properties": {
    "project": { "type": "string", "format": "uuid" },
    "answers": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["department", "question", "evidence"],
        "properties": {
          "department": { "type": "string" },
          "question": { "type": "string" },
          "text": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "otherText": { "type": "string" },
          "note": { "type": "string" },
          "transcript": { "type": "string" },
          "evidence": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

